# Copie ce fichier en .env et renseigne ta clé Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : modèle Claude à utiliser.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optionnel : nombre max de tokens par réponse d'agent.
# ANTHROPIC_MAX_TOKENS=2048

# Optionnel : nombre max d'allers-retours outils par agent.
# MCP_AGENTS_MAX_TOOL_ITERATIONS=6
